<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp"
            android:background="?android:attr/colorBackground"
            android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/battery_status_title"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: --"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Battery Level -->
        <TextView
            android:id="@+id/level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level: --%"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />


        <!-- Voltage -->
        <TextView
            android:id="@+id/voltage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltage: --"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />

        <!-- Current -->
        <TextView
            android:id="@+id/current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current: --"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />

        <!-- Power -->
        <TextView
            android:id="@+id/power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Power: --"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />

        <!-- Temperature -->
        <TextView
            android:id="@+id/temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperature: --"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="16dp" />

        <!-- Screen On -->
        <TextView
            android:id="@+id/screen_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Screen on: 00h 00m 00s"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />

        <!-- Screen Off -->
        <TextView
            android:id="@+id/screen_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 Screen off: 00h 00m 00s"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />

        <!-- Awake  -->
        <TextView
            android:id="@+id/awake_with_screen_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Awake: 00h 00m 00s"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="8dp" />

        <!-- Deep Sleep -->
        <TextView
            android:id="@+id/deep_sleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💤 Deep Sleep: 00h 00m 00s"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:layout_marginBottom="24dp" />

        <!-- Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/switch_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/battery_notification_label"
                android:textAppearance="?android:attr/textAppearanceSmall" />

            <Switch
                android:id="@+id/switch_notify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>



